# ==============================================================================
# IPL INSIGHT — AI & Analytics Configuration Example
# Copy this file to '.env' and fill in your details if using AI features.
# The application works fully even without any AI keys configured!
# ==============================================================================

# LLM Provider Configuration (OpenAI, Groq, Ollama, OpenRouter, or compatible)
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Security & Safeguards
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_ENABLE_ANALYTICS_QUERIES=true
